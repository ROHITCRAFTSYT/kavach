# Copy to .env and fill in. Real environment variables always override .env.
# Never commit .env.

# Required: your Sarvam AI API subscription key (https://dashboard.sarvam.ai)
SARVAM_API_KEY=your_key_here

# ---- Optional overrides (defaults shown) ----
# LLM used for evidence extraction and localisation (json_schema structured output)
# KAVACH_REASONING_MODEL=sarvam-105b
# LLM used for grounded Q&A and as the localisation fallback
# KAVACH_CHAT_MODEL=sarvam-105b-conversations
# Maximum upload size in MB
# KAVACH_MAX_UPLOAD_MB=25
# Audio longer than this is truncated (seconds; Batch STT supports up to 2 h)
# KAVACH_MAX_AUDIO_SECONDS=900
# Requests per minute per client IP on /api/analyze and /api/ask
# KAVACH_RATE_LIMIT_PER_MINUTE=12
# Honour X-Forwarded-For for rate limiting (only behind a proxy you control)
# KAVACH_TRUST_PROXY=0
# On Vercel, request bodies are capped at 4.5 MB: set KAVACH_MAX_UPLOAD_MB=4 there
